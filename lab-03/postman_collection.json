      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"   \",\n  \"author\": \"Test Author\",\n  \"price\": \"invalid_price\",\n  \"pages\": -10\n}"
