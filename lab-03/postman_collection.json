      "response": []
    },
    {
      "name": "GET /books/:bookId - Invalid ID (400 Bad Request)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "abc"
          ]
        },
        "description": "Tests 400 response when bookId is not a positive integer."
      },
      "response": []
    },
    {
      "name": "POST /books - Create Book (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"price\": 45,\n  \"pages\": 616\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Creates a new book and returns 201 Created with bookId."
